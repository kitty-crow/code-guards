{
  "name": "@kitty-crow/code-guards",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "bin": {
    "code-guards": "./dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.build.json && node --test dist/test/*.test.js",
    "test:bun": "tsc -p tsconfig.build.json && bun test",
    "guards": "node dist/src/cli.js",
    "guards:strict": "node dist/src/cli.js --strict",
    "guards:bun": "bun dist/src/cli.js",
    "guards:strict:bun": "bun dist/src/cli.js --strict",
    "ci": "tsc --noEmit && tsc -p tsconfig.build.json && node --test dist/test/*.test.js && node dist/src/cli.js --strict",
    "ci:bun": "tsc --noEmit && tsc -p tsconfig.build.json && bun test && bun dist/src/cli.js --strict",
    "prepare": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.2",
    "typescript": "^5.8.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.0"
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE"
  ]
}
