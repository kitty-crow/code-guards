{
  "name": "@kitty-crow/code-guards",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "bin": {
    "code-guards": "./dist/src/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "node --test dist/test/*.test.js",
    "guards": "node dist/src/cli.js",
    "guards:strict": "node dist/src/cli.js --strict",
    "ci": "npm run typecheck && npm run test && npm run guards:strict",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "typescript": "^5.8.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.0"
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE"
  ]
}
